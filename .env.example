# ── Server ──────────────────────────────────────────────
PORT=3000

# 后台鉴权（生产必改）
# 方式一（推荐）：真实账号，user:password，多个用逗号分隔
#   口令在启动时用 scrypt 哈希，不落盘明文。
ADMIN_CREDENTIALS=admin:请把这里换成强密码
# 会话签名密钥：随机长字符串，且与任何人不同享。重启后旧会话失效。
SESSION_SECRET=请换成随机长字符串

# 方式二（兼容/API 用）：单一令牌，通过 x-admin-token 头或 ?token= 访问
# 若已配置 ADMIN_CREDENTIALS，此令牌仍可作为 API 快速访问的兼容方式。
# 留空则每次启动自动生成（不固定，重启即变）。
ADMIN_TOKEN=change-me-to-a-long-random-string

# 数据存储目录（Docker 中映射到卷）
DATA_DIR=./data

# ── CORS for public submit endpoints ────────────────────
# '*' 允许任意来源；若前后端分离，设为前端域名，如 https://shop.example.com
CORS_ORIGIN=*

# ── Public base URL（用于邮件中的查看链接） ─────────────
PUBLIC_URL=https://your-domain.com

# ── 邮件通知（真实可用关键） ───────────────────────────
# 留空 SMTP_HOST 则禁用邮件（询单仍入库、仍可在后台查看）。
# 海外推荐 Resend / SendGrid；填其 SMTP 凭据。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=sales@your-domain.com
SALES_NOTIFY_EMAIL=sales@your-domain.com
DESIGN_NOTIFY_EMAIL=design@your-domain.com
