# ============================================================
#  生产环境 .env 模板（复制为 .env 后填入你自己的值）
#  不要把本文件或 .env 提交到代码仓库 / 打进分发包。
# ============================================================

# 服务端口（Docker 内固定 3000，对外由 Cloudflare/反向代理转发）
PORT=3000

# ---- 后台真实账号（强烈建议）----
# 格式：user:password，多个账号用逗号分隔。口令请用强密码。
# 示例：admin:9fK#2pQ!mZ,lisa:oL8@xT5vW
ADMIN_CREDENTIALS=admin:在这里填你的强密码
SESSION_SECRET=在这里填一段随机长字符串例如$(openssl rand -hex 32)

# ---- 兼容令牌（可选，用于 API / 自动化）----
# 已配置 ADMIN_CREDENTIALS 时仍可保留，作为程序化访问的备用方式。
ADMIN_TOKEN=另一个长随机字符串

# ---- 数据目录（Docker 映射到持久卷）----
DATA_DIR=/app/data

# ---- 跨域（前后端同域可保持 *；分离部署改为前端域名）----
CORS_ORIGIN=*

# ---- 对外公开域名（邮件里的查看/后台链接前缀）----
PUBLIC_URL=https://your-domain.com

# ---- 邮件通知（Resend / SendGrid / 其他 SMTP）----
# 海外推荐 Resend：SMTP_HOST=smtp.resend.com  PORT=465  SECURE=true
# 留空 SMTP_HOST 则关闭邮件（询单依然入库、后台可看）。
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend-api-key-or-user
SMTP_PASS=resend-api-key-or-password
SMTP_FROM=Yuzhou Crystal <noreply@your-domain.com>
NOTIFY_EMAIL=sales@your-domain.com
SALES_NOTIFY_EMAIL=sales@your-domain.com
DESIGN_NOTIFY_EMAIL=design@your-domain.com
